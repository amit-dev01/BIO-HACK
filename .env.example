# CanopyAI API Configuration

APP_NAME="CanopyAI API"
APP_VERSION="1.0.0"
API_PREFIX="/api"
ENVIRONMENT="development"
DEBUG=false

# Server binding
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (JSON array or comma-separated)
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Operational Mode
# When MOCK_MODE is true, simulated realistic metrics are returned without requiring Earth Engine or Supabase
MOCK_MODE=true

# Polygon Area Constraints (in hectares)
MIN_POLYGON_AREA_HA=0.01
MAX_POLYGON_AREA_HA=200000.0

# Supabase Credentials (optional for mock mode, enables persistent storage)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-supabase-service-role-key-backend-only
# SUPABASE_KEY=your-supabase-anon-key-fallback

# Google Earth Engine Credentials (managed by Developer 1 for live satellite pipeline)
# EARTH_ENGINE_SERVICE_ACCOUNT=
# EARTH_ENGINE_PRIVATE_KEY=

# Google Gemini API Key for AI Ecological Insights & Interactive Q&A
# GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
